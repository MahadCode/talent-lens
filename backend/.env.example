ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/hiring_ai
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

FRONTEND_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# Transactional email. SendLiberty uses your connected Gmail (no domain).
SENDLIBERTY_API_KEY=
EMAIL_FROM=Talent Lens <yourgmail@gmail.com>
# Optional: Resend instead of SendLiberty
RESEND_API_KEY=
# Optional SMTP fallback if you are not using Resend:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
