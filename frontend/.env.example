# Public FastAPI origin including /api/v1. Required for production builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional same-origin proxy used only in local Next dev if you do not set
# NEXT_PUBLIC_API_BASE_URL. Leave empty in production (Vercel/Render).
# API_REWRITE_TARGET=http://127.0.0.1:8000
